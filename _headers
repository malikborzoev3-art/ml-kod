# О Content-Security-Policy: она намеренно не задана.
# Код пользователя запускается в iframe с srcdoc (sandbox="allow-scripts allow-modals"), а такой iframe наследует CSP страницы,
# поэтому политика без 'unsafe-inline' сломала бы любые inline-скрипты и обработчики onclick в пользовательском HTML.
# Защита строится иначе: sandbox без allow-same-origin, предупреждение перед запуском кода из ссылки (#g=, #s=, #z=) и лимит распаковки.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json; charset=utf-8

